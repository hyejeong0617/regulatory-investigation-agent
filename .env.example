# Reference only: the application reads real environment variables, not this file.
# Never paste credentials into documentation, source control, logs, or chat.
INFERENCE_MODEL=gpt-6-luna
REASONING_EFFORT=medium
SOURCE_DIR=data
BENCHMARK_FILE=data/benchmark_questions_v1.json
OUTPUT_DIR=outputs
STATE_DIR=.state
MAX_LLM_CALLS_PER_QUESTION=12
MAX_TOOL_CALLS_PER_QUESTION=32
MAX_INVESTIGATION_ROUNDS=4
MAX_OUTPUT_TOKENS=6000
MAX_SECONDS_PER_QUESTION=240
API_TIMEOUT_SECONDS=60
MAX_DEVELOPMENT_TEST_API_SPEND_USD=2
RUN_PAID_TESTS=false
# PRICING_FILE=config/pricing.verified.json
# OPENAI_API_KEY must be set securely in the execution environment.
